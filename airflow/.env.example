# Copier ce fichier sous le nom .env, dans ce même dossier airflow/. `astro dev start` le lit au démarrage.
# Ne jamais versionner .env : il contient la clé privée.
#
# Une seule variable : la connexion Airflow `snowflake_nyc_taxi`, au format JSON.
#   - remplacer ORGANISATION-COMPTE, le login, le warehouse et le rôle par les vôtres ;
#   - "private_key_content" = le contenu de rsa_key.p8 encodé en Base64 (sur une ligne).
#     Avec les versions récentes du provider Snowflake, cet encodage est obligatoire
#     pour une connexion créée depuis l'interface Airflow. Pour le générer localement :
#         base64 -w 0 ~/.ssh/snowflake/rsa_key.p8
#     Ne jamais copier la sortie dans un chat ni la versionner.
AIRFLOW_CONN_SNOWFLAKE_NYC_TAXI='{"conn_type":"snowflake","login":"NYC_TAXI_AIRFLOW_SVC","schema":"RAW","extra":{"account":"ORGANISATION-COMPTE","warehouse":"NYC_TAXI_WH","database":"NYC_TAXI","role":"NYC_TAXI_ENGINEER","private_key_content":"REMPLACER_PAR_LA_CLE_PRIVEE_EN_BASE64"}}'
